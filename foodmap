<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>今天吃什麼</title>

    <style>

        body{
            margin:0;
            font-family:Arial, Helvetica, sans-serif;
        }

        header {
            display:flex;
            background-color: orange;
            color:white;
            align-items: center;
            justify-content: space-between;
            
        }

        header h1 {
            margin:5px;
            font-size: 30px;
        }

        header button {
            border-radius: 6px;
            font-weight: bold;
            font-size: larger;
        }

        .container{
            display:flex;
            height: calc(100vh - 60px);
            justify-content: space-between;
        }

        .list{
            width: 30%;
            box-shadow: -2px 0 5px;
            padding:30px;
            overflow-y: auto;
        }

        .list h2 {
            margin-top:0;
        }


    </style>
</head>
<body>
    
    <header>
        <h1>今天吃什麼?</h1>
        <div>
            <button id = "random">隨機抽取</button>
            <button id = "add">新增店家</button>
        </div>
    </header>

    <div class = "container">
        <div class = "map-area">
            <div id = "map">
                這邊之後會塞地圖
            </div>
        </div>

        <div class = "list">
            <h2>餐廳列表</h2>
            <input type = "text" id = "search" placeholder = "搜尋店名">
            
            <select id ="where">
                <option value = "中正區">中正區</option>
                <option value = "信義區">信義區</option>
                <option value = "仁愛區">仁愛區</option>
                <option value = "中山區">中山區</option>
                <option value = "安樂區">安樂區</option>
                <option value = "七堵區">七堵區</option>
                <option value = "暖暖區">暖暖區</option>
            </select>
            <div id = "storeList"></div>
        </div>
    </div>




</body>
</html>
